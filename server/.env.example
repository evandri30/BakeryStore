# Copy to .env and fill in. All services below have a free tier.

NODE_ENV=development
PORT=3000

# Local: docker compose up -d  (see docker-compose.yml in the repo root)
# Production: Neon pooled URL here, Neon direct URL in DIRECT_URL (used only for migrations)
DATABASE_URL=postgresql://rizquna:rizquna@localhost:5432/rizquna
# DIRECT_URL=

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The single admin account
SELLER_EMAIL=admin@rizquna.test
SELLER_PASSWORD=

# Used for the Midtrans "finish" redirect
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans SANDBOX server key (https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
